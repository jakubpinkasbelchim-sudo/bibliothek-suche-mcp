{
  "name": "bibliothek-suche-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Verhindert, dass wrangler deploy im Dashboard gesetzte Variablen löscht.
  "keep_vars": true,

  // Ermöglicht env.AI.run(...) im Worker
  "ai": {
    "binding": "AI"
  },

  // McpAgent basiert auf der Cloudflare-Agents-SDK, die den Zustand
  // (Sessions/SSE) in einem Durable Object hält.
  "durable_objects": {
    "bindings": [
      { "name": "MCP_OBJECT", "class_name": "BibliothekMCP" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BibliothekMCP"] }
  ],

  // @cloudflare/workers-oauth-provider speichert Clients/Tokens/Grants hier.
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "7fa381a9b25341888a64be67b04012e2"
    }
  ],

  // Nicht-geheime Konfiguration direkt hier – geht bei Deploys nicht verloren.
  // CHROMA_TENANT bitte mit deiner echten Tenant-ID befüllen.
  "vars": {
    "CHROMA_TENANT": "6426f0fc-d0bb-4edf-9b07-dcc1094a570c",
    "CHROMA_DATABASE": "BooksearchJP",
    "CHROMA_COLLECTION_ID": "eccdcae2-2d1c-4991-ae66-87f204e51b83"
  }

  // Einziges echtes Secret, NICHT hier eintragen, sondern im Dashboard
  // unter Settings -> Variables and Secrets mit Typ "Secret":
  //   CHROMA_API_KEY
}
